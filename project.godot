; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Valley of Adventure"
run/main_scene="res://scenes/Overworld.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

World="*res://scripts/world.gd"
GameState="*res://scripts/game_state.gd"
DialogueUI="*res://scenes/DialogueUI.tscn"
Items="*res://scripts/items.gd"
Inventory="*res://scripts/inventory.gd"
HUD="*res://scenes/HUD.tscn"
InventoryPanel="*res://scenes/InventoryPanel.tscn"
Character="*res://scripts/character.gd"
CharacterPanel="*res://scenes/CharacterPanel.tscn"
Storage="*res://scripts/storage.gd"
StoragePanel="*res://scenes/StoragePanel.tscn"
Crafting="*res://scripts/crafting.gd"
CraftingPanel="*res://scenes/CraftingPanel.tscn"
Enemies="*res://scripts/enemies.gd"
Spells="*res://scripts/spells.gd"
Statuses="*res://scripts/statuses.gd"
Combat="*res://scripts/combat.gd"
BattlePanel="*res://scenes/BattlePanel.tscn"
Quests="*res://scripts/quests.gd"
QuestPanel="*res://scenes/QuestPanel.tscn"
Shop="*res://scripts/shop.gd"
ShopPanel="*res://scenes/ShopPanel.tscn"
WorldMap="*res://scripts/world_map.gd"
WorldMapPanel="*res://scenes/WorldMapPanel.tscn"
Altar="*res://scripts/altar.gd"
PanelButtons="*res://scenes/PanelButtons.tscn"
QuestTracker="*res://scenes/QuestTracker.tscn"
TouchControls="*res://scenes/TouchControls.tscn"

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/stretch/mode="viewport"
window/stretch/aspect="keep_width"

[gui]

theme/custom="res://resources/ui_theme.tres"

[input]

move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
